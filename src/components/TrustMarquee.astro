---
import { supabaseImg } from "@/lib/img";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

export interface Props {
  items?: string[];
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const DEFAULT_ITEMS = t.array("trust.items");

const { items = DEFAULT_ITEMS } = Astro.props;
const trackItems = Array.from({ length: 3 }).flatMap(() => items);
const gdisLogo = supabaseImg("asset/GDISlogo.webp", { raw: true });
---

<section class="relative w-full flex items-center justify-center py-4 md:py-5 z-20 pointer-events-none overflow-hidden bg-primary shadow-[0_10px_40px_hsl(var(--primary)/0.3)] border-y border-primary/30">
  <div class="w-full overflow-hidden pointer-events-auto">
    <div class="flex w-max items-center animate-marquee">
      <div class="flex items-center flex-shrink-0">
        {trackItems.map((item) => (
          <div class="flex items-center px-6 md:px-10 flex-shrink-0">
            <span class="text-white font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">{item}</span>
            <img
              src={gdisLogo}
              alt="GDIS"
              width="60"
              height="26"
              loading="lazy"
              decoding="async"
              class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0"
            />
          </div>
        ))}
      </div>
      <div class="flex items-center flex-shrink-0" aria-hidden="true">
        {trackItems.map((item) => (
          <div class="flex items-center px-6 md:px-10 flex-shrink-0">
            <span class="text-white font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">{item}</span>
            <img
              src={gdisLogo}
              alt="GDIS Rent logo"
              width="60"
              height="26"
              loading="lazy"
              decoding="async"
              class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
