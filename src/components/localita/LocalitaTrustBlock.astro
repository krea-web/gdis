---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { GBP_RATING_VALUE, GBP_REVIEW_COUNT } from "@/lib/siteSchema";

const RATING_VALUE = GBP_RATING_VALUE.toFixed(1);
const REVIEW_COUNT = GBP_REVIEW_COUNT;
const GOOGLE_REVIEWS_URL = "https://g.page/r/CaPJPBkJmGkMEBM/review";

export interface Props {
  name: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { name } = Astro.props;

const bodyHtml = t("localita.trust.body", {
  name: `<span class="text-primary font-semibold">${name}</span>`,
});
---

<section class="py-20 md:py-24 bg-muted/20">
  <div class="container px-4 max-w-4xl mx-auto">
    <div class="bg-card border border-border rounded-3xl p-8 md:p-12 text-center" data-reveal>
      <div class="flex justify-center gap-1 mb-4" aria-label={t("localita.trust.ratingAria", { value: RATING_VALUE })}>
        {[0, 1, 2, 3, 4].map(() => (
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" class="h-6 w-6 text-amber-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        ))}
      </div>

      <p class="font-display text-3xl md:text-4xl font-bold text-foreground mb-2">
        {RATING_VALUE}<span class="text-muted-foreground text-2xl font-medium">{t("localita.trust.outOf")}</span>
      </p>
      <p class="text-sm uppercase tracking-widest text-muted-foreground mb-1">{t("localita.trust.ratingLabel")}</p>
      <p class="text-xs text-muted-foreground/80 mb-6">{t("localita.trust.reviewCount", { count: REVIEW_COUNT })}</p>

      <p class="text-base md:text-lg text-foreground/80 max-w-2xl mx-auto mb-8 leading-relaxed" set:html={bodyHtml} />

      <div class="flex justify-center">
        <a
          href={GOOGLE_REVIEWS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-primary text-primary-foreground hover:bg-brand-blue-deep shadow-lg shadow-primary/30 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          {t("localita.trust.cta")}
        </a>
      </div>
    </div>
  </div>
</section>
