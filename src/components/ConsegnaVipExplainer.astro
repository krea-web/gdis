---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

type Variant = "airport" | "port" | "station" | "generic";

export interface Props {
  variant?: Variant;
}

const { variant = "generic" } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const ICON2: Record<Variant, string> = {
  airport: "plane",
  port: "ship",
  station: "train",
  generic: "plane",
};
---

<section class="py-20 md:py-28 bg-muted/20">
  <div class="container px-4 max-w-6xl mx-auto">
    <div class="text-center mb-14" data-reveal>
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-3">{t("vipDelivery.eyebrow")}</p>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-foreground mb-4 leading-tight">
        {t("vipDelivery.title")}
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">{t(`vipDelivery.subtitle.${variant}`)}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-card rounded-2xl border border-border p-6 hover:border-primary/30 transition-colors" data-reveal>
        <div class="w-12 h-12 rounded-xl bg-[#25D366]/10 flex items-center justify-center mb-4">
          <svg viewBox="0 0 32 32" width="26" height="26" fill="#25D366" aria-hidden="true">
            <path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.128 6.744 3.046 9.378L1.054 31.29l6.118-1.958A15.907 15.907 0 0 0 16.004 32C24.826 32 32 24.826 32 16.004 32 7.176 24.826 0 16.004 0zm9.302 22.602c-.388 1.092-1.938 1.998-3.146 2.264-.826.178-1.904.32-5.534-1.19-4.646-1.932-7.634-6.634-7.866-6.942-.222-.308-1.87-2.494-1.87-4.756 0-2.264 1.184-3.378 1.604-3.838.388-.424.916-.616 1.222-.616.152 0 .286.008.41.014.42.018.63.042.906.7.346.824 1.19 2.908 1.296 3.12.106.214.214.504.066.796-.138.3-.258.486-.472.744-.214.258-.44.458-.654.74-.196.244-.416.504-.178.924.238.42 1.058 1.746 2.272 2.83 1.562 1.394 2.876 1.826 3.286 2.03.308.152.674.128.922-.132.31-.336.694-.892 1.084-1.442.278-.392.628-.44.966-.306.342.128 2.164 1.02 2.534 1.208.37.186.616.278.708.434.09.156.09.892-.298 1.984z"/>
          </svg>
        </div>
        <h3 class="font-display text-lg font-bold text-foreground mb-2">{t("vipDelivery.step1.title")}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {t("vipDelivery.step1.text")}
        </p>
      </div>

      <div class="bg-card rounded-2xl border border-border p-6 hover:border-primary/30 transition-colors" data-reveal data-reveal-delay="100">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
          {ICON2[variant] === "plane" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>}
          {ICON2[variant] === "ship" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-9-4-9 4c0 2.9.94 5.34 2.81 7.76"/><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><path d="M12 10v4"/><path d="M12 2v3"/></svg>}
          {ICON2[variant] === "train" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M8 3.1V7a4 4 0 0 0 8 0V3.1"/><path d="m9 15-1-1"/><path d="m15 15 1-1"/><path d="M9 19c-2.8 0-5-2.2-5-5v-4a8 8 0 0 1 16 0v4c0 2.8-2.2 5-5 5l1 1.5"/><path d="m8 19-1 2"/></svg>}
        </div>
        <h3 class="font-display text-lg font-bold text-foreground mb-2">{t(`vipDelivery.step2.title.${variant}`)}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">{t(`vipDelivery.step2.text.${variant}`)}</p>
      </div>

      <div class="bg-card rounded-2xl border border-border p-6 hover:border-primary/30 transition-colors" data-reveal data-reveal-delay="200">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-7.5 7.5"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
        </div>
        <h3 class="font-display text-lg font-bold text-foreground mb-2">{t(`vipDelivery.step3.title.${variant}`)}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">{t(`vipDelivery.step3.text.${variant}`)}</p>
      </div>

      <div class="bg-card rounded-2xl border border-border p-6 hover:border-primary/30 transition-colors" data-reveal data-reveal-delay="300">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.3 1 12.1 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
        </div>
        <h3 class="font-display text-lg font-bold text-foreground mb-2">{t("vipDelivery.step4.title")}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {t("vipDelivery.step4.text")}
        </p>
      </div>
    </div>
  </div>
</section>
