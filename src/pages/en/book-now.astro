---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookingFlow from "@/components/booking/BookingFlow.tsx";
import { buildHowToBookingSchema } from "@/lib/siteSchema";

const howToSchema = buildHowToBookingSchema("en");
---

<BaseLayout
  title="Book Car Rental in Olbia & Costa Smeralda Online | GDIS Rent"
  description="Book your car rental in Olbia and Costa Smeralda online: Fiat Panda, Mercedes, Honda SH scooter, Yamaha Raptor quad ✓ Sardinia car hire with a quick 6-step flow, digital signature and VIP delivery at Olbia Airport (OLB), Isola Bianca Port or hotel ✓ 24/7 on WhatsApp."
  canonical="/en/book-now"
  jsonLd={howToSchema}
  hideBackground
  i18nAlternates={{ it: "/prenotaora", de: "/de/jetzt-buchen", fr: "/fr/reserver" }}
>
  <BookingFlow client:load lang="en" />
</BaseLayout>
