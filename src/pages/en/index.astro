---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrustMarquee from "@/components/TrustMarquee.astro";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
import { buildLocalBusinessSchema, SITE_URL } from "@/lib/siteSchema";
import { supabaseImg } from "@/lib/img";
import { VEHICLE_PRICE_FROM } from "@/lib/vehiclePricing";

const homeLocalBusinessSchema = buildLocalBusinessSchema({
  id: `${SITE_URL}/#localbusiness`,
  description:
    "GDIS Rent & Service — Car, scooter and quad rental in Olbia and Costa Smeralda. VIP delivery to airport, port, hotel or villa.",
});

const serviceSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Car rental",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: [
      { "@type": "City", name: "Olbia" },
      { "@type": "AdministrativeArea", name: "Costa Smeralda" },
    ],
    url: `${SITE_URL}/noleggio-auto-a-olbia`,
    name: "Car rental in Olbia and Costa Smeralda",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Scooter rental",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: [{ "@type": "City", name: "Olbia" }],
    url: `${SITE_URL}/flotta/honda-sh`,
    name: "Honda SH scooter rental in Olbia",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Quad rental",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: [{ "@type": "AdministrativeArea", name: "Gallura" }],
    url: `${SITE_URL}/flotta/yamaha-raptor`,
    name: "Yamaha Raptor quad rental in Sardinia",
    inLanguage: "en",
  },
];

const gdisLogo = supabaseImg("asset/GDISlogo.webp", { raw: true });

const brandLogos = [
  { path: "asset/loghi/Audi.webp", alt: "Audi" },
  { path: "asset/loghi/bmw.webp", alt: "BMW" },
  { path: "asset/loghi/fiat.webp", alt: "Fiat" },
  { path: "asset/loghi/honda.webp", alt: "Honda" },
  { path: "asset/loghi/jeep.webp", alt: "Jeep" },
  { path: "asset/loghi/mercedes.webp", alt: "Mercedes" },
  { path: "asset/loghi/Yamaha.webp", alt: "Yamaha" },
];

const fleetCards = [
  {
    cat: "city_car",
    title: "City Car",
    subtitle: "Practical & Stylish",
    description: "Compact design and elegance to move around the city and discover the coast in total comfort. The perfect choice for Costa Smeralda.",
    image: "/vehicles/gdis-fiatpandacitycar.webp",
    price: VEHICLE_PRICE_FROM.city_car,
    link: "/en/book-now?vehicle=fiat-panda",
    cta: "Request this vehicle",
  },
  {
    cat: "premium",
    title: "Mercedes A-Class",
    subtitle: "Premium & Comfort",
    description: "German elegance and MBUX technology to enjoy Costa Smeralda in maximum comfort. Automatic gearbox, efficient diesel, 5 seats.",
    image: "/vehicles/gdis-mercedessupercarclassea180d.webp",
    price: VEHICLE_PRICE_FROM.premium,
    link: "/en/book-now?vehicle=mercedes-classe-a180d",
    cta: "Request this vehicle",
  },
  {
    cat: "quad",
    title: "Raptor Quad",
    subtitle: "Off-road adventure",
    description: "Pure power and adrenaline. Explore dirt tracks and hidden beaches that cars simply can't reach.",
    image: "/vehicles/gdis-yamahaquadraptor.webp",
    price: VEHICLE_PRICE_FROM.quad,
    link: "/en/book-now?vehicle=yamaha-raptor",
    cta: "Request this vehicle",
  },
  {
    cat: "scooter",
    title: "Premium Scooter",
    subtitle: "Two-wheeled freedom",
    description: "Skip the traffic and enjoy total freedom. Feel the Mediterranean breeze on your skin every time you ride.",
    image: "/vehicles/gdis-hondascooter350.webp",
    price: VEHICLE_PRICE_FROM.scooter,
    link: "/en/book-now?vehicle=honda-sh",
    cta: "Request this vehicle",
    slides: [
      {
        title: "Honda SH 125",
        subtitle: "The Mediterranean classic",
        description: "The most loved scooter for the city. Honda reliability, downtown agility, perfect for ZTL zones and tight parking.",
        image: "/vehicles/gdis-hondascooter350.webp",
        link: "/en/book-now?vehicle=honda-sh",
      },
      {
        title: "Kymco Agility 125",
        subtitle: "Practical and lightweight",
        description: "A compact, easy-to-handle scooter — perfect to move freely between Olbia and the Costa Smeralda beaches.",
        image: "https://zgazhrzjgefvjxknyffy.supabase.co/storage/v1/object/public/vehicles/gdis-kymcoagility125.png",
        link: "/en/book-now?vehicle=kymco-agility",
      },
    ],
  },
];

const destinations = [
  {
    name: "Porto Cervo",
    desc: "Luxury, yachts and the Promenade du Port.",
    path: "locations/porto-cervo/gdisrent-noleggio-porto-cervo.webp",
    to: "/en/car-rental-in-porto-cervo",
    span: "md:col-span-2 md:row-span-2",
    imgWidth: 900,
    imgHeight: 900,
    size: "lg",
  },
  {
    name: "San Teodoro",
    desc: "La Cinta, nightlife and endless beaches.",
    path: "locations/san-teodoro/gdisrent-noleggio-san-teodoro.webp",
    to: "/en/car-rental-in-san-teodoro",
    span: "md:col-span-2",
    imgWidth: 900,
    imgHeight: 450,
    size: "md",
  },
  {
    name: "Baja Sardinia",
    desc: "Phi Beach and legendary sunsets.",
    path: "locations/baja-sardinia/gdisrent-noleggio-baja-sardinia.webp",
    to: "/en/car-rental-in-baja-sardinia",
    span: "",
    imgWidth: 450,
    imgHeight: 450,
    size: "sm",
  },
  {
    name: "Olbia",
    desc: "Airport and gateway to Costa Smeralda.",
    path: "locations/olbia/gdisrent-noleggio-auto-olbia.webp",
    to: "/en/car-rental-in-olbia",
    span: "",
    imgWidth: 450,
    imgHeight: 450,
    size: "sm",
  },
  {
    name: "Porto Rotondo",
    desc: "Hidden coves and off-road adventure.",
    path: "locations/porto-rotondo/gdisrent-noleggio-porto-rotondo.webp",
    to: "/en/car-rental-in-porto-rotondo",
    span: "",
    imgWidth: 450,
    imgHeight: 450,
    size: "sm",
  },
  {
    name: "San Pantaleo",
    desc: "Bohemian village and Thursday market.",
    path: "locations/san-pantaleo/gdisrent-noleggio-san-pantaleo.webp",
    to: "/en/car-rental-in-san-pantaleo",
    span: "",
    imgWidth: 450,
    imgHeight: 450,
    size: "sm",
  },
  {
    name: "Golfo Aranci",
    desc: "Ferries, dolphins and Cala Moresca.",
    path: "locations/golfo-aranci/gdisrent-noleggio-golfo-aranci.webp",
    to: "/en/car-rental-in-golfo-aranci",
    span: "",
    imgWidth: 450,
    imgHeight: 450,
    size: "sm",
  },
];

const reviews = [
  {
    name: "Marco R.",
    location: "Milan",
    text: "Flawless service! The Panda was waiting for us right at Olbia port. Everything went perfectly, we'll definitely be back.",
    linkWord: "Panda",
    linkTo: "/en/fleet/fiat-panda",
  },
  {
    name: "Sophie L.",
    location: "Paris",
    text: "The Honda SH scooters are in perfect condition. We explored Costa Smeralda in total freedom. Fantastic VIP delivery!",
    linkWord: "Honda SH",
    linkTo: "/en/fleet/honda-sh",
  },
  {
    name: "Alessandro D.",
    location: "Rome",
    text: "The Yamaha Raptor quad is a beast! Hidden beaches you can only reach off-road. A unique experience and a lovely team.",
    linkWord: "Yamaha Raptor",
    linkTo: "/en/fleet/yamaha-raptor",
  },
];

const luxuryCar = supabaseImg("vehicles/gdisrent-exclusive-car-for-rent.webp", { width: 1400, quality: 70 });
const luxuryCarMobile = supabaseImg("vehicles/gdisrent-exclusive-car-for-rent.webp", { width: 600, quality: 70 });
---

<BaseLayout
  title="Car Rental in Olbia & Costa Smeralda | Sardinia Car Hire 24/7 | GDIS Rent"
  description="Car rental in Olbia and Costa Smeralda with VIP delivery at Olbia Airport (OLB) and Isola Bianca Port ✓ Rent a Fiat Panda, Mercedes Classe A, Honda SH scooter or Yamaha Raptor quad ✓ Olbia and Sardinia car hire for Porto Cervo, San Teodoro, Baja Sardinia ✓ Skip the queue, 24/7 WhatsApp."
  canonical="/en"
  keywords="car rental in olbia, car rental olbia, olbia car hire, rent a car olbia, costa smeralda car rental, car rental olbia airport, olbia airport car hire, car rental porto cervo, scooter rental olbia, quad rental sardinia"
  jsonLd={[homeLocalBusinessSchema, ...serviceSchemas]}
  hideBackground
  lcpImage={{ href: gdisLogo, type: "image/webp" }}
  i18nAlternates={{ it: "/", de: "/de", fr: "/fr" }}
>
  {/* HERO */}
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-brand-dark via-brand-blue-deep to-brand-dark" aria-label="GDIS Rent main hero">
    <div aria-hidden="true" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full bg-primary/20 blur-[150px] z-0 pointer-events-none"></div>
    <div class="relative z-10 container text-center flex flex-col items-center justify-center h-full px-4">
      <img
        src={gdisLogo}
        alt="GDIS Rent and Service - Vehicle rental in Sardinia"
        width="450"
        height="193"
        fetchpriority="high"
        decoding="async"
        class="w-64 md:w-80 lg:w-[450px] h-auto mb-6 drop-shadow-2xl"
      />
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-6 drop-shadow-lg">
        Rentals in Costa Smeralda.
      </h1>
      <p class="text-lg md:text-2xl text-white/80 mb-12 max-w-2xl mx-auto leading-relaxed font-light">
        <a href="/en/fleet/fiat-panda" class="text-blue-400 font-medium hover:underline hover:text-blue-300 transition-all">City Cars</a>,{" "}
        <a href="/en/fleet/honda-sh" class="text-blue-400 font-medium hover:underline hover:text-blue-300 transition-all">Scooters</a>,{" "}
        <a href="/en/fleet/yamaha-raptor" class="text-blue-400 font-medium hover:underline hover:text-blue-300 transition-all">Quads</a>{" "}
        and Luxury. <br class="hidden md:block" /> Explore Sardinia without limits.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <a
          href="/en/book-now"
          class="inline-flex items-center justify-center gap-2 px-10 py-7 text-lg font-semibold rounded-full bg-primary hover:bg-primary/90 text-primary-foreground border border-primary/50 shadow-[0_0_30px_hsl(var(--primary)/0.4)] hover:shadow-[0_0_50px_hsl(var(--primary)/0.6)] transition-all duration-300 group"
        >
          Book Now
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/en/about-us"
          class="inline-flex items-center justify-center gap-2 px-10 py-7 text-lg font-medium rounded-full bg-white/5 hover:bg-white/10 text-white border border-white/20 backdrop-blur-md transition-all duration-300"
        >
          Discover GDIS
        </a>
      </div>
    </div>
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white/50 animate-bounce" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </section>

  {/* TRUST MARQUEE */}
  <TrustMarquee />

  {/* MINIMAL INTRO */}
  <section class="relative py-20 md:py-28 flex items-center justify-center bg-transparent z-10">
    <div class="container px-4">
      <div class="max-w-5xl mx-auto text-center flex flex-col items-center" data-reveal>
        <span class="block uppercase tracking-[0.3em] text-blue-600 text-xs md:text-sm font-semibold mb-6">
          Excellence in Motion
        </span>
        <h2 class="font-display text-5xl sm:text-7xl md:text-[6rem] leading-[1.1] tracking-tighter text-slate-900 mb-8">
          <span class="block font-light">Your rental</span>
          <span class="block font-bold text-blue-600 drop-shadow-sm">starts here.</span>
        </h2>
        <p class="max-w-2xl mx-auto text-slate-500 text-lg md:text-xl font-light leading-relaxed mb-10">
          Forget queues and paperwork. A smooth digital experience that gets you on the road in moments.
        </p>
        <div class="flex items-center justify-center gap-6 md:gap-10 mb-12 flex-wrap">
          {brandLogos.map((logo) => (
            <img
              src={supabaseImg(logo.path, { raw: true })}
              alt={logo.alt}
              width="84"
              height="56"
              loading="lazy"
              decoding="async"
              class:list={[
                "h-8 md:h-10 w-auto transition-all duration-300",
                logo.alt === "BMW"
                  ? "opacity-70 hover:opacity-100 drop-shadow-[0_0_1px_rgba(0,0,0,0.6)]"
                  : "opacity-60 hover:opacity-100 grayscale hover:grayscale-0",
              ]}
            />
          ))}
        </div>
        <div class="h-[1px] w-[120px] bg-gradient-to-r from-transparent via-blue-500 to-transparent"></div>
      </div>
    </div>
  </section>

  {/* HOW IT WORKS */}
  <section class="py-24 md:py-32 bg-muted/30 relative overflow-hidden">
    <div class="container px-4">
      <div class="text-center mb-20" data-reveal>
        <p class="text-sm font-semibold tracking-[0.3em] uppercase text-primary mb-3">Simple & Fast</p>
        <h2 class="text-4xl md:text-6xl font-display font-bold text-foreground">How It Works</h2>
      </div>
      <div class="grid lg:grid-cols-5 gap-12 max-w-7xl mx-auto items-start">
        <div class="lg:col-span-3 space-y-8">
          <div class="flex gap-6 group" data-reveal>
            <div class="flex-shrink-0 relative">
              <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.3 1 12.1 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
              </div>
              <span class="absolute -top-2 -left-2 text-xs font-display font-bold text-primary bg-primary/10 rounded-full w-7 h-7 flex items-center justify-center">01</span>
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-foreground mb-2">Choose your Vehicle</h3>
              <p class="text-muted-foreground leading-relaxed">Browse our fleet and pick the perfect vehicle for your Sardinia adventure.</p>
            </div>
          </div>
          <div class="flex gap-6 group" data-reveal data-reveal-delay="120">
            <div class="flex-shrink-0 relative">
              <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
              </div>
              <span class="absolute -top-2 -left-2 text-xs font-display font-bold text-primary bg-primary/10 rounded-full w-7 h-7 flex items-center justify-center">02</span>
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-foreground mb-2">Send Your WhatsApp Request</h3>
              <p class="text-muted-foreground leading-relaxed">Pick dates and pickup location, then send a pre-filled WhatsApp request: we reply in person with availability, coverage and delivery cost.</p>
            </div>
          </div>
          <div class="flex gap-6 group" data-reveal data-reveal-delay="240">
            <div class="flex-shrink-0 relative">
              <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <span class="absolute -top-2 -left-2 text-xs font-display font-bold text-primary bg-primary/10 rounded-full w-7 h-7 flex items-center justify-center">03</span>
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-foreground mb-2">Pick Up or VIP Delivery</h3>
              <p class="text-muted-foreground leading-relaxed">Pick up the vehicle at our office or have it delivered to your hotel, port or airport.</p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-2" data-reveal data-reveal-delay="200">
          <div class="relative rounded-3xl overflow-hidden bg-primary p-8 md:p-10 text-primary-foreground shadow-[0_20px_60px_hsl(var(--primary)/0.4)]">
            <div class="absolute top-0 right-0 w-48 h-48 bg-primary-foreground/10 blur-[80px] rounded-full pointer-events-none"></div>
            <div class="relative z-10">
              <span class="text-primary-foreground/60 font-display text-xs font-bold uppercase tracking-[0.3em] mb-3 block">GDIS Exclusive</span>
              <h3 class="font-display text-2xl md:text-3xl font-bold mb-4 leading-tight">
                <span class="italic font-light">VIP</span> Delivery
              </h3>
              <p class="text-primary-foreground/70 font-light leading-relaxed mb-8">
                We bring your vehicle anywhere: villa, yacht, hotel or airport. All across Costa Smeralda.
              </p>
              <div class="grid grid-cols-2 gap-3 mb-8">
                <a href="/en/car-rental-in-olbia" class="flex items-center gap-2 bg-primary-foreground/10 rounded-xl px-3 py-3 backdrop-blur-sm hover:bg-primary-foreground/20 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground/80 flex-shrink-0"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                  <span class="text-sm font-medium text-primary-foreground/90">Olbia Airport</span>
                </a>
                <a href="/en/car-rental-in-porto-cervo" class="flex items-center gap-2 bg-primary-foreground/10 rounded-xl px-3 py-3 backdrop-blur-sm hover:bg-primary-foreground/20 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground/80 flex-shrink-0"><circle cx="12" cy="5" r="3"/><path d="M12 22V8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/></svg>
                  <span class="text-sm font-medium text-primary-foreground/90">Porto Cervo</span>
                </a>
                <div class="flex items-center gap-2 bg-primary-foreground/10 rounded-xl px-3 py-3 backdrop-blur-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground/80 flex-shrink-0"><path d="M12 22V12"/><path d="M2 22V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14"/><path d="M5 11V6"/><path d="M9 11V6"/><path d="M15 11V6"/><path d="M19 11V6"/></svg>
                  <span class="text-sm font-medium text-primary-foreground/90">Hotel & Villa</span>
                </div>
                <a href="/en/car-rental-in-san-teodoro" class="flex items-center gap-2 bg-primary-foreground/10 rounded-xl px-3 py-3 backdrop-blur-sm hover:bg-primary-foreground/20 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground/80 flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span class="text-sm font-medium text-primary-foreground/90">San Teodoro</span>
                </a>
              </div>
              <a
                href="/en/book-now"
                class="inline-flex items-center justify-center gap-2 w-full h-12 px-6 text-base font-bold rounded-full bg-primary-foreground text-primary hover:bg-primary-foreground/90 transition-all"
              >
                Book with Delivery
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FLEET SHOWCASE */}
  <section class="py-24 md:py-32 bg-muted/30 overflow-hidden relative" aria-label="Our vehicle fleet">
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle at 2px 2px, hsl(var(--foreground)) 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="container px-4 relative z-10">
      <div class="mb-20 md:mb-32 text-center max-w-3xl mx-auto" data-reveal>
        <span class="text-primary font-display text-sm font-bold uppercase tracking-[0.3em] mb-4 block">Our Fleet</span>
        <h2 class="font-display text-4xl md:text-6xl font-bold text-foreground leading-tight">
          Choose your <br class="hidden md:block" />
