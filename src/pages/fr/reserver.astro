---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookingFlow from "@/components/booking/BookingFlow.tsx";
import { buildHowToBookingSchema } from "@/lib/siteSchema";

const howToSchema = buildHowToBookingSchema("fr");
---

<BaseLayout
  title="Réserver Location Voiture à Olbia & Costa Smeralda en ligne | GDIS Rent"
  description="Réservez en ligne votre location voiture à Olbia et en Costa Smeralda : Fiat Panda, Mercedes, scooter Honda SH, quad Yamaha Raptor ✓ Loueur en Sardaigne avec procédure rapide en 6 étapes, signature numérique et livraison VIP à l'aéroport Olbia (OLB), au port Isola Bianca ou à l'hôtel ✓ 24h/24 sur WhatsApp."
  canonical="/fr/reserver"
  jsonLd={howToSchema}
  hideBackground
  i18nAlternates={{ it: "/prenotaora", en: "/en/book-now", de: "/de/jetzt-buchen" }}
>
  <BookingFlow client:load lang="fr" />
</BaseLayout>
