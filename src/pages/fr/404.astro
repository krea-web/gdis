---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
---

<BaseLayout
  title="Page non trouvée — GDIS Rent"
  description="La page que vous recherchez n'existe pas ou a été déplacée. Retournez à l'accueil ou contactez-nous sur WhatsApp."
  canonical="/fr/404"
  robots="noindex,follow"
  i18nAlternates={{ it: "/404", en: "/en/404", de: "/de/404" }}
>
  <section class="container py-32 text-center min-h-[60vh] flex flex-col items-center justify-center">
    <p class="text-sm uppercase tracking-widest text-primary mb-4">Erreur 404</p>
    <h1 class="text-5xl md:text-7xl font-display font-bold text-foreground mb-6">
      Page non trouvée
    </h1>
    <p class="text-lg text-muted-foreground max-w-xl mb-10">
      L'adresse que vous avez recherchée n'existe plus ou a été déplacée. Vous pouvez retourner à
      l'accueil ou nous joindre sur WhatsApp pour toute demande de location.
    </p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="/fr"
        class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-primary text-primary-foreground hover:bg-brand-blue-deep shadow-lg shadow-primary/30 transition-all"
      >
        Retour à l'accueil
      </a>
      <a
        href="https://wa.me/393520459150"
        target="_blank"
        rel="noopener noreferrer"
        data-wa-track="404_page"
        class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] shadow-lg transition-all"
      >
        <WhatsAppIcon size={18} />
        Écrivez-nous sur WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
