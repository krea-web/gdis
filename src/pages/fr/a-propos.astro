---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FaqList from "@/components/FaqList.astro";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
import {
  buildFaqSchema,
  BUSINESS_LEGAL_NAME,
  BUSINESS_NAME,
  BUSINESS_VAT,
  BUSINESS_TAX_ID,
  BUSINESS_REA,
  BUSINESS_FOUNDER,
} from "@/lib/siteSchema";
import { supabaseImg } from "@/lib/img";

const legalRows = [
  { label: "Dénomination", value: BUSINESS_LEGAL_NAME },
  { label: "Marque commerciale", value: BUSINESS_NAME },
  { label: "Forme juridique", value: "Société à Responsabilité Limitée (S.R.L.) — droit italien" },
  { label: "Siège social", value: "Via Annibale Caro 52, 07026 Olbia (SS), Italie" },
  { label: "N° TVA / Code fiscal", value: `IT${BUSINESS_VAT.replace(/^IT/, "")} / ${BUSINESS_TAX_ID}` },
  { label: "Numéro REA", value: `Sassari ${BUSINESS_REA}` },
  { label: "Date de constitution", value: "1er octobre 2025" },
  { label: "Inscrite au RCS", value: "7 octobre 2025 — Section ordinaire" },
  { label: "Capital social", value: "€ 10 000,00 entièrement libéré" },
  { label: "Administrateur Unique", value: `${BUSINESS_FOUNDER.name} (${BUSINESS_FOUNDER.jobTitle})` },
  { label: "E-mail certifié (PEC)", value: "gdis.servicesrl@pecdotcom.it" },
];

const heroUrl = supabaseImg(
  "asset/gdisrentservice-noleggio-auto-scooter-quad-olbia.webp",
  { raw: true },
);
const touristUrl = supabaseImg(
  "vehicles/gdisrent-consegna-auto-scooter-quad-a-domicilio.webp",
  { raw: true },
);
const transportUrl = supabaseImg(
  "asset/gdisrentservice-trasporto-merci-trasporti-eccezionali-trasporto-di-imbarcazioni.webp",
  { raw: true },
);
const gdisLogo = supabaseImg("asset/GDISlogo.webp", { raw: true });

const breadcrumbs = [
  { name: "Accueil", url: "/fr" },
  { name: "À propos", url: "/fr/a-propos" },
];

const timelineItems = [
  {
    icon: "star",
    title: "Inscrite à la CCI de Sassari",
    text: "GDIS SERVICE S.R.L. est une société à responsabilité limitée constituée le 1er octobre 2025 et inscrite au Registre des Sociétés de Sassari le 7 octobre 2025 (REA SS-225492). Une nouvelle réalité locale, mais avec une base légale, fiscale et administrative pleinement conforme dès le premier jour.",
  },
  {
    icon: "car",
    title: "Flotte diversifiée",
    text: "Fiat Panda Hybrid, Mercedes Classe A 180d, scooters Honda SH 125 et 350, quad Yamaha Raptor 700R. Chaque véhicule est assuré responsabilité civile + vol et incendie, révisé et entretenu dans une flotte dédiée au tourisme.",
  },
  {
    icon: "phone",
    title: "WhatsApp 24/7 — pas de centre d'appel",
    text: "Vous parlez directement avec le responsable opérationnel. Réservation via le web ou WhatsApp au +39 352 045 9150, signature numérique du contrat, retrait du véhicule (ou livraison). Communication directe, même en dehors des heures d'ouverture.",
  },
  {
    icon: "zap",
    title: "Livraison VIP dans toute la Gallura",
    text: "Opérateur au terminal arrivées de l'aéroport Costa Smeralda ou sous le navire au Port d'Olbia Isola Bianca. Livraison également à votre hôtel, résidence ou villa privée en Costa Smeralda, de Porto Cervo à San Teodoro.",
  },
];

const marqueeItems = [
  "Location de voitures",
  "Livraisons VIP",
  "Scooters & Quads",
  "Transports spéciaux",
  "Assistance 24/7",
  "Costa Smeralda",
];

const faqs = [
  { q: "Quels documents faut-il pour louer ?", a: "Permis de conduire valide, carte d'identité ou passeport, et carte de crédit au nom du conducteur. Pour les ressortissants hors UE, le permis de conduire international est également requis." },
  { q: "Est-il possible d'ajouter un second conducteur ?", a: "Oui, il est possible d'ajouter un second conducteur au moment de la réservation ou lors de la prise en charge du véhicule. Le second conducteur doit présenter les mêmes documents que le conducteur principal." },
  { q: "Quelle est la politique d'annulation ?", a: "L'annulation est gratuite jusqu'à 48 heures avant la prise en charge. Pour les annulations tardives, une pénalité égale à 50 % du coût total de la location est appliquée." },
  { q: "Quels sont les moyens de paiement acceptés ?", a: "Nous acceptons les cartes de crédit Visa, Mastercard et American Express. Le paiement s'effectue lors de la prise en charge du véhicule. Pour les réservations en ligne, une pré-autorisation sur la carte est requise." },
  { q: "Les véhicules sont-ils couverts par une assurance ?", a: "Tous les véhicules incluent la responsabilité civile, le vol et l'incendie. Il est possible de souscrire des couvertures supplémentaires telles que la formule tous risques et la réduction de la franchise." },
  { q: "Est-il possible de restituer le véhicule à un autre endroit ?", a: "Oui, nous proposons un service de restitution à des emplacements différents avec un léger supplément. Contactez-nous pour connaître les emplacements disponibles." },
  { q: "Proposez-vous la livraison VIP au yacht et à l'hôtel ?", a: "Absolument ! Notre service Livraison VIP apporte le véhicule directement à votre yacht, votre hôtel ou votre villa privée dans toute la Costa Smeralda et la Gallura." },
  { q: "Comment vous contacter pour les voitures de luxe ?", a: "Pour les voitures de luxe, nous vous conseillons de nous contacter directement via WhatsApp au +39 352 045 9150 pour vérifier la disponibilité et recevoir un devis dédié." },
];

const faqSchema = buildFaqSchema(faqs, { speakable: true });

const marqueeTrack = [...marqueeItems, ...marqueeItems];
---

<BaseLayout
  title="À propos — GDIS Rent | Loueur Local à Olbia depuis 2025"
  description="GDIS Rent — loueur local à Olbia (GDIS Service S.R.L., REA Sassari SS-225492, N° TVA IT03047140904) ✓ Location de voitures, scooters et quads à Olbia et en Costa Smeralda depuis 2025 ✓ Connaissance du territoire gallurais : ZTL, ferries, stationnement ✓ Siège social Via Annibale Caro 52, Olbia. WhatsApp 24h/24."
  canonical="/fr/a-propos"
  jsonLd={faqSchema}
  breadcrumbs={breadcrumbs}
  i18nAlternates={{ it: "/chisiamo", en: "/en/about-us", de: "/de/ueber-uns" }}
>
  {/* Hero */}
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroUrl}
        alt="GDIS Mobilité Costa Smeralda"
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900 z-[1]"></div>
    <div class="relative z-10 text-center px-4 max-w-5xl">
      <p class="text-blue-400 font-display text-sm font-semibold uppercase tracking-[0.3em] mb-4 block animate-fade-in">
        OLBIA · COSTA SMERALDA
      </p>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white leading-tight mb-6 drop-shadow-2xl animate-fade-in">
        Location de voitures, scooters et quads
      </h1>
      <p class="text-slate-200 text-lg md:text-2xl font-light mt-8 max-w-3xl mx-auto leading-relaxed animate-fade-in">
        GDIS Rent est la marque commerciale de <strong class="text-white font-medium">GDIS SERVICE S.R.L.</strong>, société immatriculée à la CCI de Sassari (REA SS-225492). Location à court et moyen terme avec livraison VIP à l'aéroport, au port, à l'hôtel et en villa.
      </p>
      <div class="w-32 md:w-48 h-[3px] bg-primary mx-auto mt-10 shadow-[0_0_20px_hsl(var(--primary)/0.6)]"></div>
    </div>
  </section>

  {/* Vertical timeline */}
  <section class="relative py-24 md:py-36 bg-background overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-slate-900 to-transparent pointer-events-none"></div>
    <div class="container px-4 relative z-10 max-w-3xl mx-auto pt-16">
      <div class="mb-16 md:mb-20" data-reveal>
        <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
          Notre ADN
        </span>
        <h2 class="font-display text-3xl md:text-5xl font-black text-foreground leading-tight">
          Pourquoi choisir <span class="italic font-light text-primary">GDIS</span>
        </h2>
      </div>

      {timelineItems.map((item, i) => (
        <div class="relative flex gap-6 md:gap-10" data-reveal data-reveal-delay={String(i * 100)}>
          <div class="flex flex-col items-center flex-shrink-0">
            <div class="relative z-10 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-primary flex items-center justify-center shadow-[0_0_30px_hsl(var(--primary)/0.4)]">
              {item.icon === "star" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {item.icon === "car" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.3 1 12.1 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>}
              {item.icon === "phone" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>}
              {item.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
            </div>
            {i < timelineItems.length - 1 && (
              <div class="w-px flex-1 bg-gradient-to-b from-primary/50 to-primary/10 min-h-[60px]"></div>
            )}
          </div>
          <div class="pb-14 md:pb-20">
            <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.3em]">
              0{i + 1}
            </span>
            <h3 class="font-display text-2xl md:text-3xl font-bold text-foreground mt-1 mb-3">{item.title}</h3>
            <p class="text-muted-foreground text-base md:text-lg font-light leading-relaxed max-w-lg">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* Tourist rental */}
  <section class="relative py-32 md:py-48 bg-muted overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center max-w-7xl mx-auto">
        <div class="relative order-2 lg:order-1" data-reveal>
          <div class="relative rounded-3xl overflow-hidden aspect-[4/5] shadow-2xl">
            <img src={touristUrl} alt="Location touristique Costa Smeralda" loading="lazy" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-muted via-transparent to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -right-6 md:-right-12 bg-primary rounded-2xl p-6 md:p-8 shadow-[0_20px_60px_hsl(var(--primary)/0.4)] max-w-[240px]">
            <p class="text-primary-foreground font-display font-bold text-2xl md:text-3xl">VIP</p>
            <p class="text-primary-foreground/70 font-light text-sm mt-1">Livraison aux yachts, hôtels et villas privées</p>
          </div>
        </div>

        <div class="order-1 lg:order-2" data-reveal data-reveal-delay="100">
          <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
            Notre cœur de métier
          </span>
          <h2 class="font-display text-4xl md:text-6xl font-black text-foreground leading-[1.05] mb-8">
            Explorez la Sardaigne <span class="italic font-light text-primary">avec style</span>
          </h2>
          <div class="space-y-6 text-muted-foreground text-lg font-light leading-relaxed">
            <p>
              <a href="/fr/flotte/fiat-panda" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Citadines</a>,{" "}
              <a href="/fr/flotte/honda-sh" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">scooters</a> et{" "}
              <a href="/fr/flotte/yamaha-raptor" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">quads</a> de
              dernière génération pour vivre chaque coin de la Costa Smeralda en toute liberté. Vous réservez en ligne en 2 minutes,
              vous signez numériquement et vous récupérez — ou bien nous vous l'apportons.
            </p>
            <p>
              Notre <strong class="text-foreground font-medium">Service Livraison VIP</strong> est ce qui nous rend uniques :
              le véhicule arrive directement à votre yacht à Palau, à votre villa à{" "}
              <a href="/fr/location-voiture-a-porto-cervo" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Porto Cervo</a> ou
              à votre hôtel à{" "}
              <a href="/fr/location-voiture-a-san-teodoro" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">San Teodoro</a>.{" "}
              <strong class="text-foreground font-medium">Zéro stress. Zéro file d'attente. Juste la mer.</strong>
            </p>
          </div>

          <div class="mt-10 pt-8 border-t border-border">
            <h3 class="font-display text-xl font-bold text-foreground mb-3">🏎️ Voitures de luxe & supercars</h3>
            <p class="text-muted-foreground font-light mb-6">
              Disponibles <strong class="text-foreground font-medium">exclusivement sur demande</strong>.
              Contactez-nous pour configurer votre expérience VIP sur mesure.
            </p>
            <a
              href="https://wa.me/393520459150?text=Bonjour%2C%20je%20souhaite%20des%20infos%20sur%20la%20location%20VIP%20Car"
              target="_blank"
              rel="noopener noreferrer"
              data-wa-track="chisiamo_vip_car"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] shadow-lg transition-all"
            >
              <WhatsAppIcon size={20} />
              Demander une VIP Car sur WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Trust marquee divider */}
  <section class="relative w-full flex items-center justify-center py-3 md:py-4 z-20 pointer-events-none overflow-hidden bg-primary shadow-[0_10px_40px_hsl(var(--primary)/0.3)] border-y border-primary/30">
    <div class="w-full overflow-hidden pointer-events-auto">
      <div class="flex w-max items-center animate-marquee">
        <div class="flex items-center flex-shrink-0">
          {marqueeTrack.map((item) => (
            <div class="flex items-center px-6 md:px-10 flex-shrink-0">
              <span class="text-primary-foreground font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">
                {item}
              </span>
              <img src={gdisLogo} alt="GDIS" loading="lazy" class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0" />
            </div>
          ))}
        </div>
        <div class="flex items-center flex-shrink-0" aria-hidden="true">
          {marqueeTrack.map((item) => (
            <div class="flex items-center px-6 md:px-10 flex-shrink-0">
              <span class="text-primary-foreground font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">
                {item}
              </span>
              <img src={gdisLogo} alt="Logo GDIS Rent" loading="lazy" class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Heavy transport */}
  <section class="relative py-24 md:py-32 bg-muted overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-6xl mx-auto">
        <div data-reveal>
          <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
            Services B2B
          </span>
          <h2 class="font-display text-3xl md:text-5xl font-black text-foreground leading-[1.05] mb-6">
            Transports spéciaux <span class="italic font-light text-primary">& marchandises</span>
          </h2>
          <p class="text-muted-foreground text-lg font-light leading-relaxed mb-8">
            En plus de la mobilité touristique, GDIS opère dans le secteur des transports lourds. Nous effectuons{" "}
            <strong class="text-foreground font-medium">le transport de marchandises, les transports exceptionnels et le transport d'embarcations</strong>.
            Nous opérons exclusivement avec notre personnel qualifié (services avec chauffeur), en utilisant notre flotte
            de poids lourds, camions, fourgons, remorques et semi-remorques.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="mailto:info@gdisservice.it"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-bold rounded-full bg-primary text-primary-foreground hover:bg-primary/90 transition-all"
            >
              Demander un devis transport
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a
              href="https://wa.me/393520459150?text=Bonjour%2C%20je%20souhaite%20un%20devis%20pour%20transport%20de%20marchandises"
              target="_blank"
              rel="noopener noreferrer"
              data-wa-track="chisiamo_trasporto_merci"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] shadow-lg transition-all"
            >
              <WhatsAppIcon size={16} />
              WhatsApp
            </a>
          </div>
        </div>
        <div data-reveal data-reveal-delay="200">
          <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-2xl">
            <img src={transportUrl} alt="Transports lourds GDIS" loading="lazy" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-muted via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Transparence légale — bloc E-E-A-T, sources vérifiables auprès de la CCI italienne */}
  <section class="py-20 md:py-28 bg-background relative overflow-hidden border-t border-border/40">
    <div class="container px-4 relative z-10 max-w-4xl mx-auto">
      <div class="mb-10 md:mb-14" data-reveal>
        <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-3 block">
          Transparence légale
        </span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground leading-tight">
          Données <span class="italic font-light text-primary">vérifiables</span>
        </h2>
        <p class="text-muted-foreground text-base md:text-lg font-light leading-relaxed mt-4 max-w-2xl">
          GDIS Rent opère en toute transparence fiscale et administrative. Toutes les données
          ci-dessous sont publiquement vérifiables auprès de la CCI de Sassari (Registre du Commerce italien).
        </p>
      </div>

      <dl class="grid sm:grid-cols-[max-content_1fr] gap-x-8 gap-y-3 text-sm md:text-base border-l-4 border-primary pl-6 md:pl-8" data-reveal data-reveal-delay="100">
        {legalRows.map((row) => (
          <>
            <dt class="font-display font-semibold text-foreground/80 uppercase tracking-wider text-xs md:text-sm pt-1">{row.label}</dt>
            <dd class="text-foreground font-light mb-2 sm:mb-0">{row.value}</dd>
          </>
        ))}
      </dl>

      <p class="text-xs text-muted-foreground mt-8 italic">
        Source : Visura ordinaire émise par la CCI de Sassari, Registre du Commerce italien —
        document officiel T 623229345, émis le 16/10/2025.
      </p>
    </div>
  </section>

  {/* FAQ */}
  <section class="py-24 md:py-32 bg-background relative overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
        <div class="w-full lg:w-1/3">
          <div class="sticky top-32" data-reveal>
            <span class="text-primary font-display text-sm font-bold uppercase tracking-[0.3em] mb-4 block">
              Support
            </span>
            <h2 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-6 leading-tight">
              Questions <br />
              <span class="italic font-light text-muted-foreground">fréquentes.</span>
            </h2>
            <p class="text-muted-foreground text-lg font-light mb-10 leading-relaxed">
              Tout ce que vous devez savoir avant de prendre la route. Transparence totale, zéro surprise.
            </p>
            <div class="bg-primary/5 p-8 rounded-3xl border border-primary/10">
              <h4 class="font-display font-semibold text-foreground mb-2">Vous avez d'autres questions ?</h4>
              <p class="text-sm text-muted-foreground mb-6 font-light">
                Notre équipe est à votre disposition sur WhatsApp pour clarifier le moindre doute.
              </p>
              <a
                href="https://wa.me/393520459150"
                target="_blank"
                rel="noopener noreferrer"
                data-wa-track="faq_chisiamo"
                class="inline-flex items-center justify-center gap-2 w-full h-12 px-6 text-base font-semibold rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white shadow-md hover:shadow-lg transition-all"
              >
                <WhatsAppIcon size={20} />
                Discutez avec nous
              </a>
            </div>
          </div>
        </div>
        <div class="w-full lg:w-2/3">
          <FaqList items={faqs} />
        </div>
      </div>
    </div>
  </section>

  {/* Final CTA */}
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-[hsl(var(--brand-dark))]">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,hsl(var(--primary)/0.15),transparent)]"></div>
