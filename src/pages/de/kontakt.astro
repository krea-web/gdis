---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import {
  buildLocalBusinessSchema,
  BUSINESS_EMAIL,
  BUSINESS_PHONE,
  BUSINESS_PHONE_DISPLAY,
  BUSINESS_PHONE_WHATSAPP,
} from "@/lib/siteSchema";

const breadcrumbs = [
  { name: "Home", url: "/de" },
  { name: "Kontakt", url: "/de/kontakt" },
];

const localBusinessSchema = buildLocalBusinessSchema({
  id: "https://gdisrentservice.com/de/kontakt#localbusiness",
  description:
    "Kontakt und Sitz von GDIS Rent & Service: Autovermietung, Rollerverleih und Quadverleih in Olbia und Costa Smeralda.",
});

const phoneTel = BUSINESS_PHONE;
const phoneDisplay = BUSINESS_PHONE_DISPLAY;
const waPrefilled = `https://wa.me/${BUSINESS_PHONE_WHATSAPP}?text=${encodeURIComponent(
  "Hallo GDIS Rent, ich hätte gerne Informationen zu einer Anmietung",
)}`;
---

<BaseLayout
  title="Kontakt — Autovermietung Olbia | GDIS Rent & Service"
  description="Kontaktieren Sie GDIS Rent & Service: Sitz in Via Annibale Caro 52 in Olbia, WhatsApp rund um die Uhr +39 352 045 9150, E-Mail gdis.noleggi@gmail.com. Fahrzeugübergabe am Flughafen und Hafen."
  canonical="/de/kontakt"
  breadcrumbs={breadcrumbs}
  jsonLd={localBusinessSchema}
  i18nAlternates={{ it: "/contatti", en: "/en/contact", fr: "/fr/contact" }}
>
  <div class="container pt-6">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="container pt-6 pb-12 md:pt-10 md:pb-20">
    <header class="max-w-3xl mb-10" data-reveal>
      <h1 class="font-display text-4xl md:text-6xl font-bold text-foreground mb-4">
        Kontakt — Autovermietung Olbia
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Wir befinden uns in Olbia, nur wenige Minuten vom Flughafen Costa Smeralda und vom Hafen Isola Bianca entfernt.
        Wir antworten auf WhatsApp rund um die Uhr und liefern das Fahrzeug dorthin, wo Sie es wünschen.
      </p>
    </header>

    <div class="grid md:grid-cols-2 gap-6 md:gap-10">
      <div class="space-y-4">
        <article class="bg-card border border-border rounded-2xl p-6 flex gap-4" data-reveal>
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold mb-1">Sitz</h2>
            <p class="text-muted-foreground">Via Annibale Caro 52 — 07026 Olbia (SS), Italien</p>
            <a
              href="https://www.google.com/maps?q=40.929258,9.483627"
              target="_blank"
              rel="noreferrer"
              class="text-primary hover:underline text-sm"
            >
              In Google Maps öffnen
            </a>
          </div>
        </article>

        <article class="bg-card border border-border rounded-2xl p-6 flex gap-4" data-reveal data-reveal-delay="100">
          <div class="w-12 h-12 rounded-xl bg-[#25D366]/10 flex items-center justify-center shrink-0">
            <svg viewBox="0 0 32 32" width="22" height="22" fill="#25D366" aria-hidden="true">
              <path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.128 6.744 3.046 9.378L1.054 31.29l6.118-1.958A15.907 15.907 0 0 0 16.004 32C24.826 32 32 24.826 32 16.004 32 7.176 24.826 0 16.004 0zm9.302 22.602c-.388 1.092-1.938 1.998-3.146 2.264-.826.178-1.904.32-5.534-1.19-4.646-1.932-7.634-6.634-7.866-6.942-.222-.308-1.87-2.494-1.87-4.756 0-2.264 1.184-3.378 1.604-3.838.388-.424.916-.616 1.222-.616.152 0 .286.008.41.014.42.018.63.042.906.7.346.824 1.19 2.908 1.296 3.12.106.214.214.504.066.796-.138.3-.258.486-.472.744-.214.258-.44.458-.654.74-.196.244-.416.504-.178.924.238.42 1.058 1.746 2.272 2.83 1.562 1.394 2.876 1.826 3.286 2.03.308.152.674.128.922-.132.31-.336.694-.892 1.084-1.442.278-.392.628-.44.966-.306.342.128 2.164 1.02 2.534 1.208.37.186.616.278.708.434.09.156.09.892-.298 1.984z"/>
            </svg>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold mb-1">WhatsApp rund um die Uhr</h2>
            <a
              href={`https://wa.me/${BUSINESS_PHONE_WHATSAPP}`}
              target="_blank"
              rel="noreferrer"
              data-wa-track="contatti_card"
              class="text-primary hover:underline"
            >
              +39 352 045 9150
            </a>
            <p class="text-sm text-muted-foreground mt-1">Schnelle Antwort für Buchungen und Übergaben.</p>
          </div>
        </article>

        <article class="bg-card border border-border rounded-2xl p-6 flex gap-4" data-reveal data-reveal-delay="200">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold mb-1">Telefon</h2>
            <a href={`tel:${phoneTel}`} class="text-primary hover:underline">{phoneDisplay}</a>
          </div>
        </article>

        <article class="bg-card border border-border rounded-2xl p-6 flex gap-4" data-reveal data-reveal-delay="300">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold mb-1">E-Mail</h2>
            <a href={`mailto:${BUSINESS_EMAIL}`} class="text-primary hover:underline">
              {BUSINESS_EMAIL}
            </a>
          </div>
        </article>

        <article class="bg-card border border-border rounded-2xl p-6 flex gap-4" data-reveal data-reveal-delay="400">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold mb-1">Öffnungszeiten Büro</h2>
            <ul class="text-muted-foreground text-sm space-y-0.5">
              <li>Mo–Fr: 09:00 – 19:00</li>
              <li>Sa–So: 11:30 – 17:30</li>
              <li class="text-primary font-medium">Fahrzeugübergabe rund um die Uhr nach WhatsApp-Buchung</li>
            </ul>
          </div>
        </article>

        <div class="pt-2">
          <a
            href={waPrefilled}
            target="_blank"
            rel="noreferrer"
            data-wa-track="contatti_cta"
            class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-primary text-primary-foreground hover:bg-brand-blue-deep shadow-lg shadow-primary/30 transition-all w-full sm:w-auto"
          >
            Schreiben Sie uns auf WhatsApp
          </a>
        </div>
      </div>

      <div class="rounded-2xl overflow-hidden border border-border aspect-[4/5] md:aspect-auto min-h-[420px]">
        <iframe
          title="Sitz GDIS Rent & Service — Olbia"
          src="https://www.google.com/maps?q=40.929258,9.483627&hl=de&z=16&output=embed"
          width="100%"
          height="100%"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="border-0"
        />
      </div>
    </div>
  </section>
</BaseLayout>
