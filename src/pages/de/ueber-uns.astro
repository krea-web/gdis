---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FaqList from "@/components/FaqList.astro";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
import {
  buildFaqSchema,
  BUSINESS_LEGAL_NAME,
  BUSINESS_NAME,
  BUSINESS_VAT,
  BUSINESS_TAX_ID,
  BUSINESS_REA,
  BUSINESS_FOUNDER,
} from "@/lib/siteSchema";
import { supabaseImg } from "@/lib/img";

const legalRows = [
  { label: "Firmenname", value: BUSINESS_LEGAL_NAME },
  { label: "Handelsmarke", value: BUSINESS_NAME },
  { label: "Rechtsform", value: "Gesellschaft mit beschränkter Haftung (S.R.L.) — italienisches Recht" },
  { label: "Geschäftssitz", value: "Via Annibale Caro 52, 07026 Olbia (SS), Italien" },
  { label: "USt-IdNr. / Steuernr.", value: `IT${BUSINESS_VAT.replace(/^IT/, "")} / ${BUSINESS_TAX_ID}` },
  { label: "REA-Nummer", value: `Sassari ${BUSINESS_REA}` },
  { label: "Gründungsdatum", value: "1. Oktober 2025" },
  { label: "Eingetragen am", value: "7. Oktober 2025 — Ordentlicher Abschnitt" },
  { label: "Stammkapital", value: "€ 10.000,00 (voll eingezahlt)" },
  { label: "Alleiniger Geschäftsführer", value: `${BUSINESS_FOUNDER.name} (Amministratore Unico)` },
  { label: "Zertifizierte E-Mail (PEC)", value: "gdis.servicesrl@pecdotcom.it" },
];

const heroUrl = supabaseImg(
  "asset/gdisrentservice-noleggio-auto-scooter-quad-olbia.webp",
  { raw: true },
);
const touristUrl = supabaseImg(
  "vehicles/gdisrent-consegna-auto-scooter-quad-a-domicilio.webp",
  { raw: true },
);
const transportUrl = supabaseImg(
  "asset/gdisrentservice-trasporto-merci-trasporti-eccezionali-trasporto-di-imbarcazioni.webp",
  { raw: true },
);
const gdisLogo = supabaseImg("asset/GDISlogo.webp", { raw: true });

const breadcrumbs = [
  { name: "Home", url: "/de" },
  { name: "Über uns", url: "/de/ueber-uns" },
];

const timelineItems = [
  {
    icon: "star",
    title: "Bei der Handelskammer Sassari eingetragen",
    text: "GDIS SERVICE S.R.L. ist eine am 1. Oktober 2025 gegründete Gesellschaft mit beschränkter Haftung, eingetragen am 7. Oktober 2025 in das Handelsregister Sassari (REA SS-225492). Ein neues lokales Unternehmen — vom ersten Tag an rechtlich, steuerlich und administrativ vollständig konform.",
  },
  {
    icon: "car",
    title: "Diversifizierte Flotte",
    text: "Fiat Panda Hybrid, Mercedes A-Klasse 180d, Roller Honda SH 125 und 350, Quad Yamaha Raptor 700R. Jedes Fahrzeug ist haftpflicht-, diebstahl- und brandversichert, regelmäßig gewartet und Teil einer für den Tourismus dedizierten Flotte.",
  },
  {
    icon: "phone",
    title: "WhatsApp rund um die Uhr — kein Callcenter",
    text: "Sie sprechen direkt mit dem Betriebsleiter. Buchung über Web oder WhatsApp +39 352 045 9150, digitale Vertragsunterzeichnung, Fahrzeugabholung (oder Übergabe). Direkte Kommunikation, auch außerhalb der Öffnungszeiten.",
  },
  {
    icon: "zap",
    title: "VIP-Übergabe in der gesamten Gallura",
    text: "Mitarbeiter am Ankunftsterminal des Flughafens Costa Smeralda oder direkt am Schiff im Hafen von Olbia Isola Bianca. Übergabe auch im Hotel, Residence oder in der Privatvilla in der Costa Smeralda, von Porto Cervo bis San Teodoro.",
  },
];

const marqueeItems = [
  "Autovermietung",
  "VIP-Lieferungen",
  "Roller & Quads",
  "Sondertransporte",
  "Service rund um die Uhr",
  "Costa Smeralda",
];

const faqs = [
  { q: "Welche Dokumente werden für die Anmietung benötigt?", a: "Gültiger Führerschein, Personalausweis oder Reisepass und auf den Fahrer lautende Kreditkarte. Für Bürger außerhalb der EU ist zusätzlich ein internationaler Führerschein erforderlich." },
  { q: "Kann ein zweiter Fahrer hinzugefügt werden?", a: "Ja, ein zweiter Fahrer kann zum Zeitpunkt der Buchung oder bei der Fahrzeugübernahme hinzugefügt werden. Der zweite Fahrer muss dieselben Dokumente wie der Hauptfahrer vorlegen." },
  { q: "Wie lautet die Stornierungsbedingung?", a: "Die Stornierung ist bis 48 Stunden vor der Übergabe kostenlos. Bei verspäteten Stornierungen wird eine Strafgebühr in Höhe von 50% der Gesamtmietkosten erhoben." },
  { q: "Welche Zahlungsmethoden werden akzeptiert?", a: "Wir akzeptieren Visa-, Mastercard- und American-Express-Kreditkarten. Die Zahlung erfolgt bei der Fahrzeugübernahme. Für Online-Buchungen ist eine Vorautorisierung auf der Karte erforderlich." },
  { q: "Sind die Fahrzeuge versichert?", a: "Alle Fahrzeuge enthalten Haftpflicht-, Diebstahl- und Brandversicherung. Es können zusätzliche Deckungen wie Vollkasko und Selbstbeteiligungsreduzierung erworben werden." },
  { q: "Kann das Fahrzeug an einem anderen Ort zurückgegeben werden?", a: "Ja, wir bieten den Rückgabeservice an verschiedenen Orten gegen einen kleinen Aufpreis an. Kontaktieren Sie uns, um die verfügbaren Standorte zu erfahren." },
  { q: "Bieten Sie VIP-Lieferung zu Yachten und Hotels an?", a: "Absolut! Unser VIP-Lieferservice bringt das Fahrzeug direkt zu Ihrer Yacht, Ihrem Hotel oder Ihrer Privatvilla in der gesamten Costa Smeralda und Gallura." },
  { q: "Wie kann ich Sie für Luxusfahrzeuge kontaktieren?", a: "Für Luxusfahrzeuge empfehlen wir, uns direkt über WhatsApp unter +39 352 045 9150 zu kontaktieren, um die Verfügbarkeit zu prüfen und ein individuelles Angebot zu erhalten." },
];

const faqSchema = buildFaqSchema(faqs, { speakable: true });

const marqueeTrack = [...marqueeItems, ...marqueeItems];
---

<BaseLayout
  title="Über uns — GDIS Rent | Lokale Autovermietung in Olbia seit 2025"
  description="GDIS Rent — lokale Autovermietung in Olbia (GDIS Service S.R.L., REA Sassari SS-225492, USt-IdNr. IT03047140904) ✓ Mietwagen, Roller- und Quadverleih in Olbia und an der Costa Smeralda seit 2025 ✓ Gallura-Ortskenntnis: ZTL, Fähren, Parkplätze ✓ Geschäftssitz Via Annibale Caro 52, Olbia. WhatsApp 24/7."
  canonical="/de/ueber-uns"
  jsonLd={faqSchema}
  breadcrumbs={breadcrumbs}
  i18nAlternates={{ it: "/chisiamo", en: "/en/about-us", fr: "/fr/a-propos" }}
>
  {/* Hero */}
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroUrl}
        alt="GDIS Mobilität Costa Smeralda"
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900 z-[1]"></div>
    <div class="relative z-10 text-center px-4 max-w-5xl">
      <p class="text-blue-400 font-display text-sm font-semibold uppercase tracking-[0.3em] mb-4 block animate-fade-in">
        OLBIA · COSTA SMERALDA
      </p>
      <h1 class="font-display text-5xl md:text-7xl font-bold text-white leading-tight mb-6 drop-shadow-2xl animate-fade-in">
        Auto-, Roller- und Quadvermietung
      </h1>
      <p class="text-slate-200 text-lg md:text-2xl font-light mt-8 max-w-3xl mx-auto leading-relaxed animate-fade-in">
        GDIS Rent ist der Handelsname von <strong class="text-white font-medium">GDIS SERVICE S.R.L.</strong>, einer bei der Handelskammer Sassari eingetragenen Gesellschaft (REA SS-225492). Kurz- und mittelfristige Vermietung mit VIP-Übergabe am Flughafen, Hafen, Hotel und in der Villa.
      </p>
      <div class="w-32 md:w-48 h-[3px] bg-primary mx-auto mt-10 shadow-[0_0_20px_hsl(var(--primary)/0.6)]"></div>
    </div>
  </section>

  {/* Vertical timeline */}
  <section class="relative py-24 md:py-36 bg-background overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-slate-900 to-transparent pointer-events-none"></div>
    <div class="container px-4 relative z-10 max-w-3xl mx-auto pt-16">
      <div class="mb-16 md:mb-20" data-reveal>
        <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
          Unsere DNA
        </span>
        <h2 class="font-display text-3xl md:text-5xl font-black text-foreground leading-tight">
          Warum <span class="italic font-light text-primary">GDIS</span> wählen
        </h2>
      </div>

      {timelineItems.map((item, i) => (
        <div class="relative flex gap-6 md:gap-10" data-reveal data-reveal-delay={String(i * 100)}>
          <div class="flex flex-col items-center flex-shrink-0">
            <div class="relative z-10 w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-primary flex items-center justify-center shadow-[0_0_30px_hsl(var(--primary)/0.4)]">
              {item.icon === "star" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              {item.icon === "car" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.3 1 12.1 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>}
              {item.icon === "phone" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>}
              {item.icon === "zap" && <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
            </div>
            {i < timelineItems.length - 1 && (
              <div class="w-px flex-1 bg-gradient-to-b from-primary/50 to-primary/10 min-h-[60px]"></div>
            )}
          </div>
          <div class="pb-14 md:pb-20">
            <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.3em]">
              0{i + 1}
            </span>
            <h3 class="font-display text-2xl md:text-3xl font-bold text-foreground mt-1 mb-3">{item.title}</h3>
            <p class="text-muted-foreground text-base md:text-lg font-light leading-relaxed max-w-lg">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* Tourist rental */}
  <section class="relative py-32 md:py-48 bg-muted overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center max-w-7xl mx-auto">
        <div class="relative order-2 lg:order-1" data-reveal>
          <div class="relative rounded-3xl overflow-hidden aspect-[4/5] shadow-2xl">
            <img src={touristUrl} alt="Touristische Vermietung Costa Smeralda" loading="lazy" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-muted via-transparent to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -right-6 md:-right-12 bg-primary rounded-2xl p-6 md:p-8 shadow-[0_20px_60px_hsl(var(--primary)/0.4)] max-w-[240px]">
            <p class="text-primary-foreground font-display font-bold text-2xl md:text-3xl">VIP</p>
            <p class="text-primary-foreground/70 font-light text-sm mt-1">Lieferung an Yachten, Hotels und Privatvillen</p>
          </div>
        </div>

        <div class="order-1 lg:order-2" data-reveal data-reveal-delay="100">
          <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
            Unser Kerngeschäft
          </span>
          <h2 class="font-display text-4xl md:text-6xl font-black text-foreground leading-[1.05] mb-8">
            Erkunden Sie Sardinien <span class="italic font-light text-primary">mit Stil</span>
          </h2>
          <div class="space-y-6 text-muted-foreground text-lg font-light leading-relaxed">
            <p>
              <a href="/de/flotte/fiat-panda" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Stadtautos</a>,{" "}
              <a href="/de/flotte/honda-sh" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Roller</a> und{" "}
              <a href="/de/flotte/yamaha-raptor" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Quads</a> der
              neuesten Generation, um jeden Winkel der Costa Smeralda in völliger Freiheit zu erleben. Sie buchen online in 2 Minuten,
              unterschreiben digital und holen ab — oder wir bringen es Ihnen.
            </p>
            <p>
              Unser <strong class="text-foreground font-medium">VIP-Lieferservice</strong> ist es, der uns einzigartig macht:
              Das Fahrzeug kommt direkt zu Ihrer Yacht in Palau, Ihrer Villa in{" "}
              <a href="/de/autovermietung-porto-cervo" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">Porto Cervo</a> oder
              Ihrem Hotel in{" "}
              <a href="/de/autovermietung-san-teodoro" class="text-blue-600 font-medium hover:underline hover:text-blue-700 transition-all">San Teodoro</a>.{" "}
              <strong class="text-foreground font-medium">Kein Stress. Keine Warteschlangen. Nur das Meer.</strong>
            </p>
          </div>

          <div class="mt-10 pt-8 border-t border-border">
            <h3 class="font-display text-xl font-bold text-foreground mb-3">🏎️ Luxusautos & Supersportwagen</h3>
            <p class="text-muted-foreground font-light mb-6">
              Verfügbar <strong class="text-foreground font-medium">ausschließlich auf Anfrage</strong>.
              Kontaktieren Sie uns, um Ihr maßgeschneidertes VIP-Erlebnis zu konfigurieren.
            </p>
            <a
              href="https://wa.me/393520459150?text=Hallo%2C%20ich%20h%C3%A4tte%20gerne%20Infos%20zur%20VIP-Car-Vermietung"
              target="_blank"
              rel="noopener noreferrer"
              data-wa-track="chisiamo_vip_car"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] shadow-lg transition-all"
            >
              <WhatsAppIcon size={20} />
              VIP-Car-Anfrage auf WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Trust marquee divider */}
  <section class="relative w-full flex items-center justify-center py-3 md:py-4 z-20 pointer-events-none overflow-hidden bg-primary shadow-[0_10px_40px_hsl(var(--primary)/0.3)] border-y border-primary/30">
    <div class="w-full overflow-hidden pointer-events-auto">
      <div class="flex w-max items-center animate-marquee">
        <div class="flex items-center flex-shrink-0">
          {marqueeTrack.map((item) => (
            <div class="flex items-center px-6 md:px-10 flex-shrink-0">
              <span class="text-primary-foreground font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">
                {item}
              </span>
              <img src={gdisLogo} alt="GDIS" loading="lazy" class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0" />
            </div>
          ))}
        </div>
        <div class="flex items-center flex-shrink-0" aria-hidden="true">
          {marqueeTrack.map((item) => (
            <div class="flex items-center px-6 md:px-10 flex-shrink-0">
              <span class="text-primary-foreground font-display italic font-black text-xs md:text-base uppercase tracking-[0.18em] whitespace-nowrap">
                {item}
              </span>
              <img src={gdisLogo} alt="GDIS Rent Logo" loading="lazy" class="h-5 md:h-6 w-auto opacity-90 drop-shadow-md ml-6 md:ml-10 flex-shrink-0" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Heavy transport */}
  <section class="relative py-24 md:py-32 bg-muted overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-6xl mx-auto">
        <div data-reveal>
          <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-4 block">
            B2B-Dienstleistungen
          </span>
          <h2 class="font-display text-3xl md:text-5xl font-black text-foreground leading-[1.05] mb-6">
            Sondertransporte <span class="italic font-light text-primary">& Güter</span>
          </h2>
          <p class="text-muted-foreground text-lg font-light leading-relaxed mb-8">
            Über die touristische Mobilität hinaus ist GDIS auch im Bereich Schwertransporte tätig. Wir führen{" "}
            <strong class="text-foreground font-medium">Gütertransporte, Sondertransporte und Bootstransporte</strong> durch.
            Wir arbeiten ausschließlich mit unserem qualifizierten Personal (Dienstleistungen mit Fahrer) und nutzen unsere Flotte
            aus LKW, Lastwagen, Transportern, Anhängern und Sattelaufliegern.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="mailto:info@gdisservice.it"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-bold rounded-full bg-primary text-primary-foreground hover:bg-primary/90 transition-all"
            >
              Transport-Angebot anfordern
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a
              href="https://wa.me/393520459150?text=Hallo%2C%20ich%20h%C3%A4tte%20gerne%20ein%20Angebot%20f%C3%BCr%20G%C3%BCtertransport"
              target="_blank"
              rel="noopener noreferrer"
              data-wa-track="chisiamo_trasporto_merci"
              class="inline-flex items-center justify-center gap-2 h-12 px-8 text-base font-semibold rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] shadow-lg transition-all"
            >
              <WhatsAppIcon size={16} />
              WhatsApp
            </a>
          </div>
        </div>
        <div data-reveal data-reveal-delay="200">
          <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-2xl">
            <img src={transportUrl} alt="GDIS Schwertransporte" loading="lazy" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-muted via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Rechtliche Transparenz — E-E-A-T-Block, Quellen verifizierbar bei der italienischen Handelskammer */}
  <section class="py-20 md:py-28 bg-background relative overflow-hidden border-t border-border/40">
    <div class="container px-4 relative z-10 max-w-4xl mx-auto">
      <div class="mb-10 md:mb-14" data-reveal>
        <span class="text-primary font-display text-xs font-bold uppercase tracking-[0.4em] mb-3 block">
          Rechtliche Transparenz
        </span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground leading-tight">
          Überprüfbare <span class="italic font-light text-primary">Unternehmensdaten</span>
        </h2>
        <p class="text-muted-foreground text-base md:text-lg font-light leading-relaxed mt-4 max-w-2xl">
          GDIS Rent arbeitet mit vollständiger steuerlicher und administrativer Transparenz. Alle nachstehenden Daten sind über die Handelskammer Sassari (italienisches Handelsregister) öffentlich überprüfbar.
        </p>
      </div>

      <dl class="grid sm:grid-cols-[max-content_1fr] gap-x-8 gap-y-3 text-sm md:text-base border-l-4 border-primary pl-6 md:pl-8" data-reveal data-reveal-delay="100">
        {legalRows.map((row) => (
          <>
            <dt class="font-display font-semibold text-foreground/80 uppercase tracking-wider text-xs md:text-sm pt-1">{row.label}</dt>
            <dd class="text-foreground font-light mb-2 sm:mb-0">{row.value}</dd>
          </>
        ))}
      </dl>

      <p class="text-xs text-muted-foreground mt-8 italic">
        Quelle: Ordentliche Visura der Handelskammer Sassari, italienisches Handelsregister —
        offizielles Dokument T 623229345, ausgestellt am 16/10/2025.
      </p>
    </div>
  </section>

  {/* FAQ */}
  <section class="py-24 md:py-32 bg-background relative overflow-hidden">
    <div class="container px-4 relative z-10">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
        <div class="w-full lg:w-1/3">
          <div class="sticky top-32" data-reveal>
            <span class="text-primary font-display text-sm font-bold uppercase tracking-[0.3em] mb-4 block">
              Support
            </span>
            <h2 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-6 leading-tight">
              Häufige <br />
              <span class="italic font-light text-muted-foreground">Fragen.</span>
            </h2>
            <p class="text-muted-foreground text-lg font-light mb-10 leading-relaxed">
              Alles, was Sie wissen müssen, bevor Sie sich ans Steuer setzen. Volle Transparenz, keine Überraschungen.
            </p>
            <div class="bg-primary/5 p-8 rounded-3xl border border-primary/10">
              <h4 class="font-display font-semibold text-foreground mb-2">Haben Sie weitere Fragen?</h4>
              <p class="text-sm text-muted-foreground mb-6 font-light">
                Unser Team steht Ihnen auf WhatsApp zur Verfügung, um jeden Zweifel zu klären.
              </p>
              <a
                href="https://wa.me/393520459150"
                target="_blank"
                rel="noopener noreferrer"
                data-wa-track="faq_chisiamo"
