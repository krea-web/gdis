---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookingFlow from "@/components/booking/BookingFlow.tsx";
import { buildHowToBookingSchema } from "@/lib/siteSchema";

const howToSchema = buildHowToBookingSchema("de");
---

<BaseLayout
  title="Mietwagen Olbia & Costa Smeralda online buchen | GDIS Rent"
  description="Buchen Sie online Ihren Mietwagen in Olbia und an der Costa Smeralda: Fiat Panda, Mercedes, Honda SH Roller, Yamaha Raptor Quad ✓ Autovermietung Sardinien mit schnellem 6-Schritte-Verfahren, digitaler Unterschrift und VIP-Übergabe am Flughafen Olbia (OLB), Hafen Isola Bianca oder Hotel ✓ 24/7 per WhatsApp."
  canonical="/de/jetzt-buchen"
  jsonLd={howToSchema}
  hideBackground
  i18nAlternates={{ it: "/prenotaora", en: "/en/book-now", fr: "/fr/reserver" }}
>
  <BookingFlow client:load lang="de" />
</BaseLayout>
