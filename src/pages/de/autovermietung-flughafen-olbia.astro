---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import LocalitaHero from "@/components/localita/LocalitaHero.astro";
import LocalitaFAQ from "@/components/localita/LocalitaFAQ.astro";
import LocalitaCTA from "@/components/localita/LocalitaCTA.astro";
import ConsegnaVipExplainer from "@/components/ConsegnaVipExplainer.astro";
import { buildLocalBusinessSchema, buildFaqSchema, buildServiceSchema } from "@/lib/siteSchema";

const breadcrumbs = [
  { name: "Home", url: "/de" },
  { name: "Olbia", url: "/de/autovermietung-olbia" },
  { name: "Flughafen Olbia (OLB)", url: "/de/autovermietung-flughafen-olbia" },
];

const distances = [
  { dest: "Stadtzentrum Olbia", km: 4, min: 8, road: "SS125" },
  { dest: "Hafen Isola Bianca", km: 6, min: 12, road: "SS125" },
  { dest: "San Teodoro", km: 30, min: 30, road: "SS131 dcn" },
  { dest: "Porto Cervo", km: 32, min: 35, road: "SS125 → SP59" },
  { dest: "San Pantaleo", km: 25, min: 30, road: "SS125 → SP73" },
  { dest: "Baja Sardinia", km: 35, min: 40, road: "SS125 → SP59" },
  { dest: "Golfo Aranci", km: 20, min: 22, road: "SS125 → SP82" },
  { dest: "La Maddalena (Verschiffung)", km: 45, min: 55, road: "SS125 bis Palau" },
];

const carriers = [
  { name: "Volotea", segment: "Low-cost", note: "Hauptdrehkreuz OLB mit operativer Basis" },
  { name: "easyJet", segment: "Low-cost", note: "Flüge aus London, Berlin, Mailand und weiteren EU-Strecken" },
  { name: "Ryanair", segment: "Low-cost", note: "Sommersaison, hauptsächlich UK und Irland" },
  { name: "ITA Airways", segment: "Full-service", note: "Inseldienst nach Rom und Mailand LIN" },
  { name: "Lufthansa", segment: "Full-service", note: "Sommerliche Direktflüge aus München und Frankfurt" },
  { name: "Air France", segment: "Full-service", note: "Saisonal Paris CDG" },
];

const faqs = [
  { q: "Wie lautet der IATA-Code des Flughafens Olbia?", a: "Der IATA-Code ist <strong>OLB</strong> (ICAO-Code <strong>LIEO</strong>). Der offizielle Name lautet <em>Flughafen Olbia – Costa Smeralda</em>, betrieben von Geasar S.p.A. Es ist nach Cagliari-Elmas der zweitgrößte Flughafen Sardiniens nach Passagieraufkommen." },
  { q: "Ist der Flughafen Olbia ganzjährig oder nur im Sommer geöffnet?", a: "Er ist ganzjährig geöffnet, weist jedoch eine sehr ausgeprägte Saisonalität auf: <strong>über 60 % des Verkehrs</strong> konzentrieren sich zwischen Juni und September. In der Nebensaison werden viele internationale Strecken eingestellt; aktiv bleiben vor allem die Inselverbindungen nach Rom Fiumicino und Mailand Linate." },
  { q: "Was passiert, wenn mein Flug nach Alghero oder Cagliari umgeleitet wird?", a: "Das kommt selten vor, meist wegen schlechten Wetters. Bei einer Umleitung kontaktieren Sie uns sofort über WhatsApp: Je nach Uhrzeit verlegen wir die Übergabe auf den tatsächlichen Flughafen (mit transparent vereinbartem Kraftstoffaufschlag) oder warten in Olbia auf Sie, wenn Sie Bus oder Shuttle nehmen." },
  { q: "Kann ich das Fahrzeug abholen, wenn ich mit einem Haustier in der Transportbox reise?", a: "Ja. Bitte geben Sie es nur bei der Buchung an: Bei Autos legen wir eine Sitzauflage aus, für Roller informieren wir über die Vorschriften zum Transport kleiner Tiere. Wer mit einem mittelgroßen oder großen Hund reist, dem empfehlen wir den <a href='/de/flotte/fiat-panda' class='text-primary underline'>Fiat Panda</a> (5 Sitze, geräumiger Kofferraum)." },
  { q: "Kann ich auch bei Nacht- oder Frühflügen mieten?", a: "Ja, wir decken die gesamte Betriebszeit des Flughafens ab. Die Lieferung ist bei Mietzeiten ab 3 Tagen auch in den Nachtstunden kostenlos; unter 3 Tagen erheben wir einen kleinen, bei der Buchung mitgeteilten Aufschlag für Randzeiten." },
  { q: "Sind Kindersitze inklusive?", a: "Ja, auf Anfrage bei der Buchung und kostenlos. Verfügbar sind Sitze der Gruppen 0+/1/2/3 nach ECE R44/04 oder i-Size. Teilen Sie uns das Alter des Kindes mit, damit wir den passenden Sitz vor Ihrer Ankunft bereitstellen." },
];

const localBusinessSchema = buildLocalBusinessSchema({
  id: "https://gdisrentservice.com/noleggio-auto-aeroporto-olbia#localbusiness",
  description: "Autovermietung am Flughafen Olbia Costa Smeralda (OLB) mit VIP-Lieferung am Ankunftsterminal. Echtzeit-Flugüberwachung, Distanzen zur Costa Smeralda, Terminal- und Parkinformationen.",
  areaServed: [
    { "@type": "Airport", name: "Flughafen Olbia Costa Smeralda" },
    { "@type": "City", name: "Olbia" },
  ],
});

const faqSchema = buildFaqSchema(faqs, { speakable: true });

const serviceSchema = buildServiceSchema({
  name: "Autovermietung Flughafen Olbia Costa Smeralda",
  description:
    "VIP-Lieferservice für Mietfahrzeuge direkt am Ankunftsvorplatz des Flughafens Olbia Costa Smeralda (OLB). Flugüberwachung in Echtzeit.",
  serviceType: "Airport Car Rental Delivery",
  url: "/noleggio-auto-aeroporto-olbia",
  areaServed: [
    { "@type": "Airport", name: "Flughafen Olbia Costa Smeralda" },
    { "@type": "City", name: "Olbia" },
    { "@type": "AdministrativeArea", name: "Costa Smeralda" },
  ],
});

const heroImage = "https://zgazhrzjgefvjxknyffy.supabase.co/storage/v1/object/public/locations/olbia/gdisrent-noleggio-auto-aeroporto-olbia.webp";
---

<BaseLayout
  title="Autovermietung Flughafen Olbia OLB | Lieferung am Ankunftsterminal | GDIS Rent"
  description="Autovermietung Flughafen Olbia Costa Smeralda OLB. VIP-Lieferung direkt am Ankunftsterminal, Flugüberwachung, reale Distanzen und Zeiten zur Costa Smeralda. Online buchen 24/7."
  canonical="/de/autovermietung-flughafen-olbia"
  jsonLd={[localBusinessSchema, serviceSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
  ogImage={heroImage}
  i18nAlternates={{ it: "/noleggio-auto-aeroporto-olbia", en: "/en/car-rental-olbia-airport", fr: "/fr/location-voiture-aeroport-olbia" }}
>
  <LocalitaHero
    name="Flughafen Olbia"
    h1Prefix="Autovermietung"
    h1Accent="Flughafen Olbia"
    subtitle="IATA-Code OLB. VIP-Lieferung am Ankunftsvorplatz des Costa Smeralda Airport — Sie landen, wir übergeben das Auto, Sie fahren los."
    bgImage={heroImage}
  />

  <div class="container pt-6">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-16 md:py-24 bg-background">
    <div class="container max-w-5xl">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
        <span class="text-xs uppercase tracking-widest text-primary font-semibold">So funktioniert die Lieferung am OLB</span>
      </div>
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-6" data-reveal>
        Drei Schritte zwischen Landung und Reisebeginn
      </h2>

      <div class="grid md:grid-cols-3 gap-6 mt-10">
        <div class="rounded-2xl border border-border bg-card p-6" data-reveal>
          <div class="text-primary text-3xl font-display font-bold mb-3">01</div>
          <h3 class="font-semibold mb-2">Überwachte Landung</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Wir verfolgen Ihren Flug in Echtzeit anhand der Buchungsnummer. Frühe oder verspätete Ankünfte werden ohne Ihr Zutun berücksichtigt: Unser Mitarbeiter erscheint zur tatsächlichen Ankunftszeit.
          </p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6" data-reveal data-reveal-delay="100">
          <div class="text-primary text-3xl font-display font-bold mb-3">02</div>
          <h3 class="font-semibold mb-2">Treffen am GDIS-Schild</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Unser Mitarbeiter in Uniform erwartet Sie in der Ankunftshalle mit einem personalisierten Namensschild. Gut erkennbar, kein Anstehen am Schalter, keine Suche an überfüllten Theken.
          </p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6" data-reveal data-reveal-delay="200">
          <div class="text-primary text-3xl font-display font-bold mb-3">03</div>
          <h3 class="font-semibold mb-2">Digitale Unterschrift & los geht's</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Vertrag auf dem Smartphone unterschrieben, Fotos zum Fahrzeugzustand, Schlüssel in der Hand. Weniger als 10 Minuten nach Gepäckausgabe sind Sie bereits auf der SS125.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-muted/20">
    <div class="container max-w-5xl">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="text-xs uppercase tracking-widest text-primary font-semibold">Reale Distanzen ab OLB</span>
      </div>
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-4" data-reveal>
        Wie lange Sie wirklich bis zu Ihrem Ziel brauchen
      </h2>
      <p class="text-muted-foreground mb-8" data-reveal>
        Zeiten ohne Verkehr berechnet. In der Hochsaison (Juli-August, Wochenenden) auf Strecken zur Costa Smeralda 15-30 % zuschlagen.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card">
        <table class="w-full text-sm">
          <thead class="bg-muted/40 text-xs uppercase tracking-wider text-muted-foreground">
            <tr>
              <th class="text-left py-3 px-4 font-semibold">Ziel</th>
              <th class="text-right py-3 px-4 font-semibold">Km</th>
              <th class="text-right py-3 px-4 font-semibold">Min</th>
              <th class="text-left py-3 px-4 font-semibold">Straße</th>
            </tr>
          </thead>
          <tbody>
            {distances.map((d) => (
              <tr class="border-t border-border">
                <td class="py-3 px-4 font-medium">{d.dest}</td>
                <td class="py-3 px-4 text-right text-muted-foreground">{d.km}</td>
                <td class="py-3 px-4 text-right text-muted-foreground">{d.min}</td>
                <td class="py-3 px-4 text-muted-foreground text-xs">{d.road}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-background">
    <div class="container max-w-5xl">
      <div class="flex items-center gap-3 mb-4" data-reveal>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.3 1 12.1 1 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
        <span class="text-xs uppercase tracking-widest text-primary font-semibold">Fluggesellschaften am OLB</span>
      </div>
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-6" data-reveal>
        Egal mit welcher Airline Sie landen — wir warten auf Sie
      </h2>
      <p class="text-muted-foreground leading-relaxed mb-8" data-reveal>
        Der Flughafen Costa Smeralda wickelt in den Sommermonaten rund <strong>3 Millionen Passagiere</strong> ab, mit Flügen aus ganz Europa. Unser System erkennt jede IATA-Flugnummer: Ob Sie mit einem saisonalen Low-Cost-Flug oder einer Inselverbindung ankommen — der Übergabeablauf ist identisch.
      </p>

      <div class="grid sm:grid-cols-2 gap-3">
        {carriers.map((c) => (
          <div class="rounded-xl border border-border bg-card p-4 flex items-start gap-3">
            <div class="shrink-0 px-2 py-1 rounded-md bg-primary/10 text-primary text-[10px] uppercase tracking-wider font-semibold">
              {c.segment}
            </div>
            <div>
              <div class="font-semibold">{c.name}</div>
              <div class="text-xs text-muted-foreground mt-0.5">{c.note}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-amber-500/20 bg-amber-500/5 p-5 flex gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 shrink-0 mt-0.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        <div class="text-sm">
          <p class="font-semibold text-foreground mb-1">Operative Hinweise zum Flughafen</p>
          <p class="text-muted-foreground leading-relaxed">
            Olbia hat ein einziges Terminal (keine getrennten Bereiche Schengen/Nicht-Schengen auf der Ankunftsseite). Die Wartezeiten an der Gepäckausgabe können in der Hochsaison 30 Minuten überschreiten — das ist sogar zu Ihrem Vorteil: Kein Druck am Taxistand oder an überfüllten Schaltern, und Sie können uns in Ruhe in der Ankunftshalle finden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ConsegnaVipExplainer variant="airport" />

  <LocalitaFAQ name="Flughafen Olbia (OLB)" faqs={faqs} />

  <section class="py-12 bg-muted/20">
    <div class="container px-4 text-center max-w-2xl">
      <p class="text-muted-foreground">
        Sie landen am Costa Smeralda? Sehen Sie auch unsere Zielseiten:{" "}
        <a href="/de/autovermietung-olbia" class="text-primary font-medium hover:underline">Stadtzentrum Olbia</a>,{" "}
        <a href="/de/autovermietung-porto-cervo" class="text-primary font-medium hover:underline">Porto Cervo</a> und{" "}
        <a href="/de/autovermietung-san-teodoro" class="text-primary font-medium hover:underline">San Teodoro</a>.
      </p>
    </div>
  </section>

  <LocalitaCTA name="Flughafen Olbia" />
</BaseLayout>
